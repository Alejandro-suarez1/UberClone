<file path="src/utils/calculateFare.js">
import { PRICING } from '../config/pricing';

/**
 * @param {{distanceKm:number, durationMin:number, category?:string, tip?:number, commissionRate?:number}} input
 * @returns {{fare:number, commission:number, driverEarnings:number}}
 */
export function calculateFare({
  distanceKm,
  durationMin,
  category = 'economy',
  tip = 0,
  commissionRate = PRICING.commissionRate,
}) {
  const multiplier = PRICING.categoryMultiplier[category];
  if (multiplier === undefined) {
    throw new Error(`Categoría inválida: ${category}`);
  }
  if (!Number.isFinite(distanceKm) || distanceKm < 0 || !Number.isFinite(durationMin) || durationMin < 0) {
    throw new Error('Distancia y duración deben ser números mayores o iguales a 0');
  }

  const raw = (PRICING.baseFare + distanceKm * PRICING.perKm + durationMin * PRICING.perMinute) * multiplier;
  const fare = Math.round(Math.max(PRICING.minimumFare, raw) / PRICING.roundTo) * PRICING.roundTo;
  const commission = Math.round(fare * commissionRate);
  const cleanTip = Math.max(0, Math.round(Number(tip) || 0));

  return {
    fare,
    commission,
    driverEarnings: fare - commission + cleanTip,
  };
}
</file>

<file path="src/utils/dateRanges.js">
export function startOfDay(date = new Date()) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate(), 0, 0, 0, 0);
}

export function endOfDay(date = new Date()) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate(), 23, 59, 59, 999);
}

export function startOfWeek(date = new Date()) {
  const day = (date.getDay() + 6) % 7; 
  return startOfDay(new Date(date.getFullYear(), date.getMonth(), date.getDate() - day));
}

export function startOfMonth(date = new Date()) {
  return new Date(date.getFullYear(), date.getMonth(), 1, 0, 0, 0, 0);
}

export function getRange(kind, customFrom, customTo, now = new Date()) {
  switch (kind) {
    case 'today':
      return { since: startOfDay(now).getTime(), until: endOfDay(now).getTime() };
    case 'week':
      return { since: startOfWeek(now).getTime(), until: endOfDay(now).getTime() };
    case 'month':
      return { since: startOfMonth(now).getTime(), until: endOfDay(now).getTime() };
    case 'range': {
      const since = customFrom ? startOfDay(customFrom).getTime() : undefined;
      const until = customTo ? endOfDay(customTo).getTime() : undefined;
      return { since, until };
    }
    default:
      return { since: undefined, until: undefined };
  }
}
</file>

<file path="src/utils/format.js">
export function formatCOP(value) {
  const n = Math.round(Number(value) || 0);
  const sign = n < 0 ? '-' : '';
  return `${sign}$${String(Math.abs(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.')}`;
}

const pad = (n) => String(n).padStart(2, '0');

export function toISODate(date) {
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}

export function parseISODate(iso) {
  if (typeof iso !== 'string') return null;
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
  if (!match) return null;
  const [, y, m, d] = match.map(Number);
  const date = new Date(y, m - 1, d);
  if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== d) return null;
  return date;
}

export function formatISODate(iso) {
  const date = parseISODate(iso);
  return date ? `${pad(date.getDate())}/${pad(date.getMonth() + 1)}/${date.getFullYear()}` : '';
}

export function formatDate(ts) {
  const d = new Date(ts);
  return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;
}

export function formatDateTime(ts) {
  const d = new Date(ts);
  return `${formatDate(ts)} · ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

export function formatKm(km) {
  return `${(Math.round((Number(km) || 0) * 10) / 10).toString().replace('.', ',')} km`;
}

export function placeLabel(place) {
  if (!place) return '';
  if (place.address) return place.address;
  return `${Number(place.lat).toFixed(4)}, ${Number(place.lng).toFixed(4)}`;
}
