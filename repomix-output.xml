import { useEffect, useState } from 'react';
import { useDriverSession } from '../context/DriverSessionContext';
import { requestLocationPermission, watchPlace } from '../services/locationService';
import { updateDriverLocation } from '../services/tripService';

/**
 * @returns {{ location: {lat:number,lng:number}|null, error: 'permission'|'unavailable'|null }}
 */
export default function useDriverLocation({ enabled }) {
  const { driverId } = useDriverSession();
  const [location, setLocation] = useState(null);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!enabled || !driverId) return undefined;

    let cancelled = false;
    let subscription = null;
    let lastSavedLocation = null;

    (async () => {
      try {
        const granted = await requestLocationPermission();
        if (cancelled) return;
        if (!granted) {
          setError('permission');
          return;
        }
        setError(null);
        
        const sub = await watchPlace((place) => {
          if (cancelled) return;
          
          if (
            lastSavedLocation && 
            lastSavedLocation.lat === place.lat && 
            lastSavedLocation.lng === place.lng
          ) {
            return;
          }

          lastSavedLocation = place;
          setLocation(place);
          updateDriverLocation(driverId, place).catch((err) => {
            console.error("Error al actualizar ubicación en BD:", err);
          });
        });

        if (cancelled) {
          sub.remove();
        } else {
          subscription = sub;
        }
      } catch (e) {
        if (!cancelled) {
          setError('unavailable');
          console.error("Error en el servicio de geolocalización:", e);
        }
      }
    })();

    return () => {
      cancelled = true;
      if (subscription) subscription.remove();
    };
  }, [enabled, driverId]);

  return { location, error };
}
</file>

<file path="src/hooks/useEarnings.js">
// AI-assisted: see docs/AI_LOG.md #A-38
import { useMemo } from 'react';
import { startOfDay, startOfMonth, startOfWeek } from '../utils/dateRanges';
import { PAYMENT_METHOD, TRIP_STATUS } from '../contracts/types';

const EMPTY = { count: 0, billed: 0, commissions: 0, tips: 0, net: 0, average: 0 };

function summarize(trips) {
  if (trips.length === 0) return { ...EMPTY };
  const totals = trips.reduce(
    (acc, trip) => ({
      count: acc.count + 1,
      billed: acc.billed + (trip.fare || 0),
      commissions: acc.commissions + (trip.commission || 0),
      tips: acc.tips + (trip.tip || 0),
      net: acc.net + (trip.driverEarnings || 0),
    }),
    { count: 0, billed: 0, commissions: 0, tips: 0, net: 0 },
  );
  return { ...totals, average: Math.round(totals.net / totals.count) };
}

const isFinished = (trip) => trip.status === TRIP_STATUS.COMPLETED || trip.status === TRIP_STATUS.PAID;

export default function useEarnings(trips) {
  return useMemo(() => {
    const finished = (trips || []).filter(isFinished);
    const now = new Date();
    const dayStart = startOfDay(now).getTime();
    const weekStart = startOfWeek(now).getTime();
    const monthStart = startOfMonth(now).getTime();

    const since = (from) => finished.filter((trip) => (trip.completedAt || trip.createdAt) >= from);

    const balance = finished.reduce((acc, trip) => {
      if (trip.paymentMethod === PAYMENT_METHOD.CASH) {
        return trip.status === TRIP_STATUS.PAID ? acc - (trip.commission || 0) : acc;
      }
      return trip.status === TRIP_STATUS.PAID ? acc + (trip.driverEarnings || 0) : acc;
    }, 0);

    return {
      today: summarize(since(dayStart)),
      week: summarize(since(weekStart)),
      month: summarize(since(monthStart)),
      balance,
    };
  }, [trips]);
}
</file>

<file path="src/hooks/useTripHistory.js">
// AI-assisted: see docs/AI_LOG.md #A-40
import { useCallback, useEffect, useRef, useState } from 'react';
import { useDriverSession } from '../context/DriverSessionContext';
import { getDriverTrips } from '../services/tripService'; // servicio de B
import { getMockDriverTrips } from '../utils/mockTrips';
import { ENV, HISTORY_PAGE_SIZE } from '../config/env';

const MAX_PAGES_WHEN_LOADING_ALL = 25;

export default function useTripHistory({ since, until, paymentMethod, pageSize = HISTORY_PAGE_SIZE, loadAll = false } = {}) {
  const { driverId } = useDriverSession();
  const [trips, setTrips] = useState([]);
  const [loading, setLoading] = useState(true);
  const [loadingMore, setLoadingMore] = useState(false);
  const [hasMore, setHasMore] = useState(false);
  const [error, setError] = useState(null);

  const cursorRef = useRef(null);
  const requestId = useRef(0);

  const fetchPage = useCallback(
    (cursor) => {
      const fetcher = ENV.USE_MOCKS ? getMockDriverTrips : getDriverTrips;
      return fetcher(driverId, { since, until, paymentMethod, cursor: cursor ?? undefined, limit: pageSize });
    },
    [driverId, since, until, paymentMethod, pageSize],
  );

  const load = useCallback(async () => {
    const current = ++requestId.current;
    setLoading(true);
    setError(null);
    cursorRef.current = null;
    try {
      let all = [];
      let cursor = null;
      let pages = 0;
      do {
        const page = await fetchPage(cursor);
        if (current !== requestId.current) return; // llegó una consulta más nueva
        all = all.concat(page.trips);
        cursor = page.nextCursor;
        pages += 1;
      } while (loadAll && cursor !== null && pages < MAX_PAGES_WHEN_LOADING_ALL);

      cursorRef.current = cursor;
      setTrips(all);
      setHasMore(cursor !== null);
    } catch (e) {
      if (current === requestId.current) setError(e);
    } finally {
      if (current === requestId.current) setLoading(false);
    }
  }, [fetchPage, loadAll]);

  // Cada vez que cambian los filtros se vuelve a empezar desde la primera página
  useEffect(() => {
    if (!driverId) return;
    load();
  }, [driverId, load]);

  const loadMore = useCallback(async () => {
    if (loading || loadingMore || !hasMore || cursorRef.current === null) return;
    const current = requestId.current;
    setLoadingMore(true);
    try {
      const page = await fetchPage(cursorRef.current);
      if (current !== requestId.current) return;
      cursorRef.current = page.nextCursor;
      setTrips((prev) => prev.concat(page.trips));
      setHasMore(page.nextCursor !== null);
    } catch (e) {
      setError(e);
    } finally {
      setLoadingMore(false);
    }
  }, [fetchPage, hasMore, loading, loadingMore]);

  return { trips, loading, loadingMore, hasMore, error, loadMore, refresh: load };
}
</file>

<file path="src/hooks/useTripRequests.js">
import { useCallback, useEffect, useRef, useState } from 'react';
import { subscribeToRequests, updateTripStatus } from '../services/tripService';
import { REQUEST_TIMEOUT_SECONDS } from '../config/env';
import { TRIP_STATUS } from '../contracts/types';

/**
 * @returns {{ request: object|null, secondsLeft: number, accept: () => Promise<object|null>, reject: () => Promise<void> }}
 */
export default function useTripRequests({ driverId, enabled }) {
  const [request, setRequest] = useState(null);
  const [secondsLeft, setSecondsLeft] = useState(0);

  const requestRef = useRef(null);
  const handledIds = useRef(new Set());
  const rejectRef = useRef(null);

  useEffect(() => {
    requestRef.current = request;
  }, [request]);

  useEffect(() => {
    if (!enabled || !driverId) {
      setRequest(null);
      return undefined;
    }
    const unsubscribe = subscribeToRequests(driverId, (trips) => {
      setRequest((current) => {
        if (current) {
          return trips.some((trip) => trip.id === current.id) ? current : null;
        }
        return trips.find((trip) => !handledIds.current.has(trip.id)) || null;
      });
    });
    return unsubscribe;
  }, [driverId, enabled]);

  const reject = useCallback(
    async (reason) => {
      const current = requestRef.current;
      if (!current) return;
      handledIds.current.add(current.id);
      setRequest(null);
      try {
        await updateTripStatus(current.id, TRIP_STATUS.REJECTED, {
          rejectedBy: driverId,
          rejectReason: reason === 'timeout' ? 'timeout' : 'driver',
        });
      } catch (e) {
        console.warn('Error al rechazar la solicitud en el backend:', e);
      }
    },
    [driverId],
  );

  useEffect(() => {
    rejectRef.current = reject;
  }, [reject]);

  const accept = useCallback(async () => {
    const current = requestRef.current;
    if (!current) return null;
    handledIds.current.add(current.id);
    setRequest(null);
    try {
      await updateTripStatus(current.id, TRIP_STATUS.ACCEPTED, { acceptedAt: Date.now() });
      return { ...current, status: TRIP_STATUS.ACCEPTED };
    } catch (e) {
      handledIds.current.delete(current.id);
      setRequest(current);
      throw e;
    }
  }, []);

  const requestId = request?.id;
  useEffect(() => {
    if (!requestId) {
      setSecondsLeft(0);
      return undefined;
    }
    const deadline = Date.now() + REQUEST_TIMEOUT_SECONDS * 1000;
    setSecondsLeft(REQUEST_TIMEOUT_SECONDS);

    const timer = setInterval(() => {
      const left = Math.ceil((deadline - Date.now()) / 1000);
      if (left <= 0) {
        clearInterval(timer);
        setSecondsLeft(0);
        rejectRef.current?.('timeout');
      } else {
        setSecondsLeft(left);
      }
    }, 250);

    return () => clearInterval(timer);
  }, [requestId]);

  return { request, secondsLeft, accept, reject };
}
</file>

